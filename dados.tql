insert
$carro isa carro, has codigo "V001", has modelo "Carro de Ana";
$moto isa moto, has codigo "V002", has modelo "Moto de Bruno";
$caminhao isa caminhao, has codigo "V003", has modelo "Caminhão de Carla";
$moto2 isa moto, has codigo "V004", has modelo "Moto de Diego";
$ana isa pessoa, has codigo "P001", has nome "Ana";
$bruno isa pessoa, has codigo "P002", has nome "Bruno";
$carla isa pessoa, has codigo "P003", has nome "Carla";
$diego isa pessoa, has codigo "P004", has nome "Diego";
$placa1 isa placa, has valor-placa "ABC1D23";
$placa2 isa placa, has valor-placa "DEF4G56";
$placa3 isa placa, has valor-placa "GHI7J89";
$placa4 isa placa, has valor-placa "JKL0M12";
identificacao (identificado: $carro, identificador: $placa1);
identificacao (identificado: $moto, identificador: $placa2);
identificacao (identificado: $caminhao, identificador: $placa3);
identificacao (identificado: $moto2, identificador: $placa4);
conducao (condutor: $ana, veiculo-conduzido: $carro);
conducao (condutor: $bruno, veiculo-conduzido: $moto);
conducao (condutor: $carla, veiculo-conduzido: $caminhao);
conducao (condutor: $diego, veiculo-conduzido: $moto2);
$capacete isa capacete, has codigo "E001", has nome "Capacete de Bruno";
$bota isa calcado, has codigo "E002", has nome "Bota de Bruno";
$tenis isa calcado, has codigo "E003", has nome "Tênis de Diego";
uso-equipamento (usuario: $bruno, item: $capacete);
uso-equipamento (usuario: $bruno, item: $bota);
uso-equipamento (usuario: $diego, item: $tenis);

$r1 isa roda, has codigo "R001", has posicao "dianteira esquerda";
$r2 isa roda, has codigo "R002", has posicao "dianteira direita";
$r3 isa roda, has codigo "R003", has posicao "traseira esquerda";
$r4 isa roda, has codigo "R004", has posicao "traseira direita";
composicao (todo: $carro, parte: $r1);
composicao (todo: $carro, parte: $r2);
composicao (todo: $carro, parte: $r3);
composicao (todo: $carro, parte: $r4);
$r5 isa roda, has codigo "R005", has posicao "dianteira";
$r6 isa roda, has codigo "R006", has posicao "traseira";
composicao (todo: $moto, parte: $r5);
composicao (todo: $moto, parte: $r6);
$r7 isa roda, has codigo "R007", has posicao "dianteira esquerda";
$r8 isa roda, has codigo "R008", has posicao "dianteira direita";
$r9 isa roda, has codigo "R009", has posicao "traseira esquerda externa";
$r10 isa roda, has codigo "R010", has posicao "traseira esquerda interna";
$r11 isa roda, has codigo "R011", has posicao "traseira direita interna";
$r12 isa roda, has codigo "R012", has posicao "traseira direita externa";
composicao (todo: $caminhao, parte: $r7);
composicao (todo: $caminhao, parte: $r8);
composicao (todo: $caminhao, parte: $r9);
composicao (todo: $caminhao, parte: $r10);
composicao (todo: $caminhao, parte: $r11);
composicao (todo: $caminhao, parte: $r12);
$r13 isa roda, has codigo "R013", has posicao "dianteira";
$r14 isa roda, has codigo "R014", has posicao "traseira";
composicao (todo: $moto2, parte: $r13);
composicao (todo: $moto2, parte: $r14);
